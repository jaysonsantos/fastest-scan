root = true

[*]
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
end_of_line = lf
charset = utf-8

[*.{yml,yaml,nix,json,sh,toml,bib}]
indent_size = 2

# The text of a numbered list item starts after "1. " or "10. ", so a continued line
# has 3 or 4 spaces. No one indent size is correct for Markdown.
[*.md]
indent_size = unset
