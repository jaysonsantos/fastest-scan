<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The app also works with no camera: it can open a recorded video. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- largeHeap: the native memory of a scan does not count for the Java heap, but
        the pages for the screen and for the PDF do. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- fullUser: the screen turns with the phone, in each of the four directions,
            when the user allows the rotation of the screen. The library needs the
            frames upright: the fold of a book goes from the top to the bottom.
            configChanges: the activity handles the turn itself. A new activity
            for each turn would lose the scan and its pages. -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Another app can open a video with this app: a file manager, or the gallery. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
