<?xml version="1.0" encoding="utf-8"?>
<!-- The picture of the camera, and the panel with the text and the buttons. The
    panel is below the picture when the phone is upright, and at the side of the
    picture when the phone is on its side: `MainActivity.arrange` changes the
    directions of `root` and `buttons`. The panel thus never covers the picture. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/picture"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <br.com.jayson.fastestscan.ui.PageOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- The picture is at the start of this frame. On a long screen, this
            corner is free: the small page does not cover the picture. -->
        <ImageView
            android:id="@+id/last_page"
            android:layout_width="@dimen/last_page_width"
            android:layout_height="@dimen/last_page_height"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:contentDescription="@string/last_page_description"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- A screen on its side can be lower than the panel: the panel then scrolls.
        fillViewport: on a higher screen, the panel fills it, and the space below
        the text keeps the buttons at the lower end. -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Two lines at least: the picture does not change its size when the text
                changes its length. -->
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <!-- At the side of the picture, the panel is as high as the screen: the
                buttons stay at its lower end. -->
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- The name of the PDF: it shows when the scan has pages. `PdfName` makes
                the file name from the field and the check box. -->
            <LinearLayout
                android:id="@+id/name_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/name_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/name_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:text="@string/default_pdf_name"
                    android:textColor="@android:color/white" />

                <CheckBox
                    android:id="@+id/prefix_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/check_prefix"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <!-- For a test: the camera writes a video of the scan to a file too. -->
            <CheckBox
                android:id="@+id/video_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/check_video"
                android:textColor="@android:color/white" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/camera_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/button_camera" />

                <Button
                    android:id="@+id/video_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/button_gap"
                    android:layout_weight="1"
                    android:text="@string/button_video" />

                <Button
                    android:id="@+id/save_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/button_gap"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/button_save" />

                <Button
                    android:id="@+id/share_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/button_gap"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/button_share" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
